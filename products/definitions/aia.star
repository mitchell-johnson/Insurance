# Definitions for the AIA products. Each text says, in this system's own
# words, what event the cover responds to and names the AIA appendix whose
# definition governs a claim (code and version as published; see
# docs/aia-products.md). The published wording, not this summary, is the
# contract: claims assess against it. A new AIA version is a new version
# here with its own effective date, so cover bound to the old one keeps it.

FROM = "2026-11-14"

DEFINITIONS = [
    definition("aia-death", 1, FROM, "Death",
               "The life assured dies while the cover is in force. Governing wording: AIA Living Life Cover appendix 1101 AL-LIFE v5; Family Protection 1103 AL-FP v6; Cover for Life 1400 A-CFL v1; Essentials Life Cover; business life 1151 ALB-LIFE v4."),
    definition("aia-terminal-illness", 1, FROM, "Terminal illness",
               "A registered medical practitioner diagnoses an illness that, despite reasonable treatment, is expected to cause death within 12 months. Governing wording: 1101 AL-LIFE v5 section 2 and the matching section of each life appendix."),
    definition("aia-specified-terminal-conditions", 1, FROM, "Specified terminal conditions",
               "An unequivocal diagnosis of one of the incurable conditions the wording lists (motor neurone disease; exocrine pancreatic cancer stage 3 or 4; non-small cell lung cancer stage 4; distal oesophageal cancer stage 4), whatever the life expectancy. Governing wording: 1101 AL-LIFE v5 section 3."),
    definition("aia-accidental-death", 1, FROM, "Accidental death",
               "Death caused solely by violent, accidental, external and visible means, before the life assured turns 65; no payment for intentional self-injury within 13 months of cover starting. Governing wording: 1102 AL-AD v3."),
    definition("aia-critical-conditions", 1, FROM, "Critical Conditions",
               "First diagnosis after cover starts of one of the 50-plus conditions the appendix lists, at full or partial severity, and survival for 14 days (90 days for the optional TPD condition). Certain conditions have a 90-day stand-down from receipt of the application. Governing wording: 1105 AL-CC v9 (22 September 2026)."),
    definition("aia-progressive-care", 1, FROM, "Progressive Care",
               "One of 70 defined conditions in five categories (cancer; heart and arteries; brain and nerves; loss of function; other health events), paid by severity level, more than once, until 100% has been paid in a category. Survival of 14 days; some conditions have a three-month stand-down. Governing wording: 1106 AL-PC v7."),
    definition("aia-severe-trauma", 1, FROM, "Severe Trauma",
               "First diagnosis of one of the higher-severity conditions the appendix lists, paid in full only (no partial payments), with survival of 14 days (six months for conditions the wording names). 90-day stand-down for marked conditions. Governing wording: 1119 AL-ST v2."),
    definition("aia-tpd-own-occupation", 1, FROM, "Total permanent disablement, own occupation",
               "Through illness or injury the life assured has been unable to work in their own occupation for three consecutive months and is unlikely ever to return to it, and survives the three months; partial permanent disablement pays the lower of 25% and $100,000. Governing wording: 1104 AL-TPD v4."),
    definition("aia-tpd-any-occupation", 1, FROM, "Total permanent disablement, any occupation",
               "As for own occupation, but unlikely ever to work in any occupation reasonably suited to the life's education, training or experience that pays more than 25% of the earnings of the year before. Governing wording: 1104 AL-TPD v4."),
    definition("aia-ip-total-disability", 1, FROM, "Income protection total and partial disability",
               "Total disability: unable through illness or injury to work more than 10 hours a week in the usual occupation and under medical care. Partial disability: working, but at reduced hours or earnings after a disability. Benefits are paid monthly from the end of the waiting period. Governing wording: 1108 AL-IP v5, 1115 AL-IND v5, 1109 AL-LOE v5, 1117 AL-MIRC v2."),
    definition("aia-ip-agreed-value", 1, FROM, "Agreed value income",
               "The monthly benefit is agreed at application from proven income and paid at that amount, less offsets such as ACC. Governing wording: 1108 AL-IP v5."),
    definition("aia-ip-indemnity", 1, FROM, "Indemnity income",
               "The monthly benefit is the lower of the amount insured and 75% of pre-disability income proven at claim, less offsets. Governing wording: 1115 AL-IND v5."),
    definition("aia-ip-loss-of-earnings", 1, FROM, "Loss of earnings income",
               "The monthly benefit replaces the earnings actually lost, up to the amount insured, less offsets. Governing wording: 1109 AL-LOE v5."),
    definition("aia-mortgage-income-rent", 1, FROM, "Mortgage, income or rent cover",
               "A monthly benefit up to 115% of mortgage or rent payments on the residential home, or 45% of gross income; ACC and other mortgage cover are offset only above $7,500 a month across AIA mortgage-type benefits. Governing wording: 1117 AL-MIRC v2."),
    definition("aia-retirement-protection", 1, FROM, "Retirement protection",
               "While a total disability income benefit is paid, a monthly amount towards retirement saving, less offsets. Governing wording: 1111 AL-RP v2."),
    definition("aia-redundancy", 1, FROM, "Redundancy",
               "Made redundant after the first six months of cover, having been an earner for the six months before: the monthly benefit for up to six months, less redundancy pay counted up to 13 weeks. Governing wording: 1113 AL-RED v1."),
    definition("aia-specified-accidental-injury", 1, FROM, "Specified accidental injury",
               "An accident causing one of the injuries in categories A to E (fractures, ruptures needing surgery, amputations, burns, loss of sight or hearing, paralysis), paying 1, 2, 3, 6 or 12 times the chosen monthly amount, on top of ACC. Governing wording: 1116 AL-SAIC v1 (business 1165 ALB-SAIC v1)."),
    definition("aia-specialist-testing", 1, FROM, "Specialist and testing support",
               "Specialist consultations and listed diagnostic tests and procedures at an approved facility on referral by a registered medical practitioner, in New Zealand, less the chosen excess once a policy year. Governing wording: 1118 AL-STS v2 (1 November 2026)."),
    definition("aia-business-continuity", 1, FROM, "Business continuity",
               "A key person is totally disabled and cannot work more than 10 hours a week in the business: a monthly benefit, agreed value or indemnity, paid on top of ACC. Governing wording: 1158 ALB-BC v3."),
    definition("aia-rural-continuity", 1, FROM, "Rural continuity",
               "A farmer, sharemilker, farm manager or family member with succession rights is totally disabled and cannot farm more than 10 hours a week: an agreed monthly benefit, with or without ACC offsets as chosen. Governing wording: 1159 ALB-RC v4; Business Income Support upgrade 1160 ALB-BI v3."),
    definition("aia-start-up-income", 1, FROM, "Start-up income protection",
               "A business owner trading for three years or less is totally disabled and cannot work more than 10 hours a week: an agreed monthly benefit from a share of business revenue. Governing wording: 1180 A-SU IP v3."),
    definition("aia-private-health", 1, FROM, "Private health",
               "Surgical, medical and cancer treatment at an approved facility in New Zealand, and the other benefits the AIA Private Health schedule lists, less the chosen excess once a policy year; benefits for pre-existing conditions as the wording sets out. Governing wording: 1300 APH-UMB v8 (1 November 2026)."),
    definition("aia-cancer-care", 1, FROM, "Cancer care",
               "Diagnosis, treatment and recovery costs for cancer at an approved facility in New Zealand, as the AIA Cancer Care schedule lists, less the chosen excess. Governing wording: 1304 AIA Cancer Care-UMB v5 (1 November 2026)."),
    definition("aia-group-life", 1, FROM, "Group life",
               "An insured employee dies or is diagnosed terminally ill while a member of the scheme. Governing wording: AIA Corporate Solutions life policy for the scheme."),
    definition("aia-group-tpd", 1, FROM, "Group total permanent disablement",
               "An insured employee is totally and permanently disabled as the scheme's policy defines. Governing wording: AIA Corporate Solutions policy for the scheme."),
    definition("aia-group-critical-illness", 1, FROM, "Group critical illness",
               "An insured employee suffers a covered critical illness or, under Severe Trauma for Corporate Solutions (from 5 May 2026), a covered severe condition. Governing wording: AIA Corporate Solutions policy for the scheme."),
    definition("aia-group-income", 1, FROM, "Group income protection",
               "An insured employee is unable to work through sickness or injury after the scheme's waiting period: a monthly share of salary. Governing wording: AIA Corporate Solutions policy for the scheme."),
]
